# The CRM (Next.js). The deploy workflow copies this in and enables it on
# every deploy. Port 3100: call-assistant has 3000 on the same box.
[Unit]
Description=Takeaway Counter CRM
After=network.target postgresql.service

[Service]
User=deploy
WorkingDirectory=/home/deploy/takeaway-counter
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/usr/bin/npm start -- -p 3100 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
