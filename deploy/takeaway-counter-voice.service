# The receptionist's voice server. Separate from the CRM's own service so a
# CRM deploy never has to drop a live call. See README: "Deployment".
#
# The deploy workflow copies this in and enables it on every deploy.
# Port 4620: call-assistant's voice server has 4610 on the same box.
[Unit]
Description=Takeaway Counter voice server (the phone receptionist)
After=network.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/takeaway-counter
Environment=NODE_ENV=production
Environment=VOICE_PORT=4620
ExecStart=/usr/bin/npx tsx src/voice-server/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
