# Database (docker compose up -d gives you this one locally)
DATABASE_URL=postgresql://dev:dev@localhost:5432/takeaway_dev

# Auth (NextAuth v5, email + password, JWT sessions)
AUTH_SECRET=                              # openssl rand -base64 32
AUTH_URL=http://localhost:3000            # the public https address in production
AUTH_TRUST_HOST=true                      # required behind a reverse proxy

# The receptionist's brain. A shop can also have its own key on its
# organisation row (anthropicApiKeyOverride), billed separately.
ANTHROPIC_API_KEY=
# RECEPTIONIST_MODEL=claude-haiku-5-5     # the default; any Claude model id
# RECEPTIONIST_EFFORT=medium              # low | medium | high (Haiku 5.5 only)

# The voice server (npm run voice) and the CRM must share this secret: the CRM
# signs short-lived passes with it and the voice server checks them.
RECEPTIONIST_VOICE_SECRET=                # openssl rand -hex 32
# Where browsers and Twilio reach the voice server: ws:// locally, wss:// in production.
RECEPTIONIST_VOICE_URL=ws://127.0.0.1:4610/voice

# Hearing and speaking (voice server only)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=                    # a British voice from the standard library by default
# ELEVENLABS_SPEED=0.9
# DEEPGRAM_ENDPOINTING_MS=400             # how long a pause ends the caller's turn

# The phone line. Twilio's voice webhook (/api/twilio/voice) is checked with
# this token over the URL Twilio called.
TWILIO_AUTH_TOKEN=
# TWILIO_VOICE_WEBHOOK_URL=https://your-host/api/twilio/voice   # only if the proxy rewrites the host

# Local only: VOICE_FAKES=1 runs the voice server with a stand-in model,
# recogniser and voice, so the audio path can be tried with no accounts.
# DEV_BYPASS_AUTH=1 / NEXT_PUBLIC_DEV_BYPASS_AUTH=1 skip the login (never in production builds).
